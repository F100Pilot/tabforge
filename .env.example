# Copy to .env (never commit .env). Dev values only.
POSTGRES_USER=tabforge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tabforge
S3_ACCESS_KEY=tabforge
S3_SECRET_KEY=change-me-dev-secret

TABFORGE_ENV=dev
TABFORGE_DATABASE_URL=postgresql://tabforge:change-me@postgres:5432/tabforge
TABFORGE_CORS_ORIGINS=["http://localhost:3000"]
# M1 walking skeleton: all requests act as one dev user. Refused unless TABFORGE_ENV=dev.
TABFORGE_DEV_AUTH=true

# Same keys as S3_ACCESS_KEY / S3_SECRET_KEY above.
TABFORGE_S3_ACCESS_KEY=tabforge
TABFORGE_S3_SECRET_KEY=change-me-dev-secret
TABFORGE_S3_BUCKET=tabforge-audio
TABFORGE_S3_ENDPOINT_URL=http://s3:7070
# Host the browser uses for pre-signed upload URLs.
TABFORGE_S3_PUBLIC_ENDPOINT_URL=http://localhost:7070

NEXT_PUBLIC_API_URL=http://localhost:8000
