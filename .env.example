# Copy to .env (never commit .env). Dev values only.
POSTGRES_USER=tabforge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tabforge
S3_ACCESS_KEY=tabforge
S3_SECRET_KEY=change-me-dev-secret

TABFORGE_ENV=dev
TABFORGE_DATABASE_URL=postgresql://tabforge:change-me@postgres:5432/tabforge
TABFORGE_CORS_ORIGINS=["http://localhost:3000"]
# Requests without a session cookie act as one dev user. Refused unless TABFORGE_ENV=dev.
# Set to false to try the real login (magic link, US-07).
TABFORGE_DEV_AUTH=true

# Auth (US-07, ADR-0006). The login link points to the web app.
TABFORGE_WEB_BASE_URL=http://localhost:3000
# Dev runs over plain http; keep the default (true) everywhere else.
TABFORGE_SESSION_COOKIE_SECURE=false
TABFORGE_SESSION_TTL_DAYS=30
TABFORGE_LOGIN_TOKEN_TTL_S=900
# Generic SMTP; in dev, the compose Mailpit service (inbox UI at http://localhost:8025).
# Without TABFORGE_SMTP_HOST, env=dev writes the link to the api log; other envs refuse to start.
TABFORGE_SMTP_HOST=mailpit
TABFORGE_SMTP_PORT=1025
# Mailpit speaks plain SMTP; real providers: port 587 with STARTTLS (the default) and credentials.
TABFORGE_SMTP_STARTTLS=false
# TABFORGE_SMTP_USERNAME=
# TABFORGE_SMTP_PASSWORD=
TABFORGE_MAIL_FROM="TabForge <no-reply@tabforge.local>"

# Same keys as S3_ACCESS_KEY / S3_SECRET_KEY above.
TABFORGE_S3_ACCESS_KEY=tabforge
TABFORGE_S3_SECRET_KEY=change-me-dev-secret
TABFORGE_S3_BUCKET=tabforge-audio
TABFORGE_S3_ENDPOINT_URL=http://s3:7070
# Host the browser uses for pre-signed upload URLs.
TABFORGE_S3_PUBLIC_ENDPOINT_URL=http://localhost:7070

# Worker pipeline: real (Demucs + Basic Pitch, CPU works but is slower) or stub (fixed tab, no ML).
TABFORGE_WORKER_PIPELINE=real

NEXT_PUBLIC_API_URL=http://localhost:8000
